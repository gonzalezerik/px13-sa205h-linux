# SPDX-License-Identifier: AGPL-3.0-or-later
# Generated by `cargo xtask generate-udev-rules`; do not edit by hand.
#
# Grants the signed-in user access to the pen-related hidraw nodes.
# TAG+="uaccess" follows the active seat, so no group needs to be
# maintained. The leading digits of each hid name are the HID bus
# type (0018 = over I2C, 0005 = over Bluetooth), not a boot number.

# ELAN9008 (ASUS ProArt PX13 HN7306)
SUBSYSTEM=="hidraw", KERNELS=="0018:04F3:4631.*", TAG+="uaccess"

# MPP 2.6 haptic pen (ASUS SA205H class)
SUBSYSTEM=="hidraw", KERNELS=="0005:330A:0001.*", TAG+="uaccess"

# Keep the pens' Bluetooth keyboard and mouse away from the desktop:
# libinput-based compositors ignore them, px13pend reads the
# top-button gestures from hidraw instead.
# MPP 2.6 haptic pen (ASUS SA205H class)
SUBSYSTEM=="input", KERNELS=="0005:330A:0001.*", ENV{LIBINPUT_IGNORE_DEVICE}="1"
