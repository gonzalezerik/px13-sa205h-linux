# System-bus activation for the pairing helper. The bus starts the
# process when someone first calls it; the unit is Type=dbus, so there
# is nothing to enable. @PREFIX@ is substituted at install time.

[D-BUS Service]
Name=io.github.gonzalezerik.Px13Pen.PairHelper1
Exec=@PREFIX@/libexec/px13pen-pair-helper
User=root
SystemdService=px13pen-pair-helper.service
