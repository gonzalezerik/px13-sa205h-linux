# D-Bus activated (Type=dbus): the system bus starts this unit when the
# helper's name is first called. There is no [Install] section and
# nothing to enable. @PREFIX@ is substituted at install time.

[Unit]
Description=Open Pen Protocol pairing helper
Documentation=https://github.com/gonzalezerik/open-pen-protocol

[Service]
Type=dbus
BusName=org.openpenprotocol.PairHelper1
ExecStart=@PREFIX@/libexec/opp-pair-helper
User=root
# The management socket is the only privilege this service needs; every
# request is additionally gated by the org.openpenprotocol.pair-pen
# polkit action before the socket is even opened.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
RestrictNamespaces=yes
LockPersonality=yes
