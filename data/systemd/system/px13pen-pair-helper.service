# D-Bus activated (Type=dbus): the system bus starts this unit when the
# helper's name is first called. There is no [Install] section and
# nothing to enable. @PREFIX@ is substituted at install time.

[Unit]
Description=PX13 SA205H Linux pairing helper
Documentation=https://github.com/gonzalezerik/px13-sa205h-linux

[Service]
Type=dbus
BusName=io.github.gonzalezerik.Px13Pen.PairHelper1
ExecStart=@PREFIX@/libexec/px13pen-pair-helper
User=root
# The management socket is the only privilege this service needs; every
# request is additionally gated by the io.github.gonzalezerik.Px13Pen.pair-pen
# polkit action before the socket is even opened.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
RestrictNamespaces=yes
LockPersonality=yes
