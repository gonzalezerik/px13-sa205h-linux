# SPDX-License-Identifier: AGPL-3.0-or-later
# musl build: Alpine 3.24. Same stages as Containerfile.glibc; CI builds both on
# x86_64 and aarch64 (native runners, no emulation).
#   podman build -f container/Containerfile.musl -t px13-sa205h-linux:musl .
#   podman build -f container/Containerfile.musl --target test .
ARG RUST_IMAGE=docker.io/library/rust:1.99.1-alpine3.24
ARG RUNTIME_IMAGE=docker.io/library/alpine:3.24

FROM ${RUST_IMAGE} AS build
WORKDIR /src
# Everything except the settings window builds here: a static musl link has no
# GTK stack to link against (docs/decisions.md, "musl is the headless half").
# The GTK dev packages stay because clippy still configures the sys crates;
# fmt and clippy cover the settings sources without linking them.
RUN apk add --no-cache musl-dev pkgconf gtk4.0-dev libadwaita-dev
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tools ./tools
COPY contrib ./contrib
COPY data ./data
RUN cargo build --release --locked --workspace --exclude px13pen-settings

FROM build AS test
RUN rustup component add clippy rustfmt \
 && cargo fmt --all --check \
 && cargo run --locked -p xtask -- generate-udev-rules --check \
 && cargo clippy --locked --workspace --all-targets -- -D warnings \
 && cargo test --locked --workspace --exclude px13pen-settings

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=build /src/target/release/px13pend /src/target/release/px13penctl /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/px13pend"]

# Distribution tarball: the headless install tree (no settings window,
# docs/decisions.md) staged at /usr/local plus the install script.
#   podman build -f container/Containerfile.musl --target dist -t dist .
#   podman cp $(podman create dist):/px13-sa205h-linux-dev-x86_64-musl.tar.gz .
FROM build AS dist
ARG VERSION=dev
RUN D="px13-sa205h-linux-${VERSION}-$(uname -m)-musl" \
 && DESTDIR=/pkg PREFIX=/usr/local cargo run --locked -p xtask -- install --headless \
 && cp tools/dist/install.sh tools/dist/README-INSTALL.md /pkg/ \
 && chmod 755 /pkg/install.sh \
 && mkdir /out && mv /pkg "/out/$D" \
 && tar -czf "/$D.tar.gz" -C /out "$D"
