# SPDX-License-Identifier: AGPL-3.0-or-later
# glibc build: Debian trixie. Same stages as Containerfile.musl; CI builds both on
# x86_64 and aarch64 (native runners, no emulation).
#   podman build -f container/Containerfile.glibc -t px13-sa205h-linux:glibc .
#   podman build -f container/Containerfile.glibc --target test .
ARG RUST_IMAGE=docker.io/library/rust:1.99.1-trixie
ARG RUNTIME_IMAGE=docker.io/library/debian:trixie-slim

FROM ${RUST_IMAGE} AS build
WORKDIR /src
# The settings window builds against the system GTK 4 / libadwaita.
RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libgtk-4-dev libadwaita-1-dev \
 && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tools ./tools
COPY contrib ./contrib
COPY data ./data
RUN cargo build --release --locked --workspace

FROM build AS test
RUN rustup component add clippy rustfmt \
 && cargo fmt --all --check \
 && cargo run --locked -p xtask -- generate-udev-rules --check \
 && cargo clippy --locked --workspace --all-targets -- -D warnings \
 && cargo test --locked --workspace

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=build /src/target/release/px13pend /src/target/release/px13penctl /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/px13pend"]

# Distribution tarball: the install tree staged at /usr/local plus the
# install script the tarball ships with. Release builds name the file after
# the version tag and the machine it was built on; building by hand:
#   podman build -f container/Containerfile.glibc --target dist -t dist .
#   podman cp $(podman create dist):/px13-sa205h-linux-dev-x86_64-glibc.tar.gz .
FROM build AS dist
ARG VERSION=dev
RUN D="px13-sa205h-linux-${VERSION}-$(uname -m)-glibc" \
 && DESTDIR=/pkg PREFIX=/usr/local cargo run --locked -p xtask -- install \
 && cp tools/dist/install.sh tools/dist/README-INSTALL.md /pkg/ \
 && chmod 755 /pkg/install.sh \
 && mkdir /out && mv /pkg "/out/$D" \
 && tar -czf "/$D.tar.gz" -C /out "$D"
